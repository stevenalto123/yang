# Supabase PostgreSQL Connection String (Transaction Pooler port 6543 or Session Pooler 5432)
# Set these in Vercel: Project Settings -> Environment Variables (Production)
SUPABASE_DB_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Secret used to sign HMAC-SHA256 JWT tokens (set a long random string in Vercel)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Admin access code for authorized City of Manila DRRM administrators
ADMIN_INVITE_CODE="LC-MANILA-ADMIN-2026"

# Gmail SMTP credentials for Forgot Password 6-digit email reset codes (100% free via Gmail App Password)
# 1. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
# 2. Create an App Password named "LifeCheckpoint" and paste the 16-letter code below
GMAIL_USER="your-app-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
