# Supabase PostgreSQL Connection String (Transaction Pooler port 6543 or Session Pooler 5432)
# Set this in Netlify UI: Site configuration -> Environment variables (Scope: Functions)
SUPABASE_DB_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Secret used to sign HMAC-SHA256 JWT tokens (set a long random string in Netlify UI)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Invite code allowing EAC researchers/admins to register as Admin & export Chapter 4 CSV analytics
ADMIN_INVITE_CODE="EAC-DRRM-2026"
